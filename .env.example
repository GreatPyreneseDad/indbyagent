NEXT_PUBLIC_SITE_URL=https://indbyagent.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Neon Postgres connection string for venue/vendor suggestions (schema: neon/migrations).
# Required in production; unset in dev = in memory. Not the Neon API key.
NEON_DATABASE_URL=
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
HOST_SECRET=
AGENTMAIL_SHARED_INBOX=   # optional: used for every party once the AgentMail inbox limit is hit
STRIPE_SECRET_KEY=   # optional: enables provider 'stripe' for host-authorized vendor payments

AGENTMAIL_POOL_INBOXES=   # optional: comma list of existing inboxes to reuse when the plan limit is hit
MAIL_KEY_SECRET=   # encrypts subscribers own AgentMail keys (any long random string)
